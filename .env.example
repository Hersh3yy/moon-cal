# LUNATRACK environment. Copy to .env and fill in.
# Both are public (client-side) keys used by the SPA at runtime.

# RapidAPI — moon-phase.p.rapidapi.com (moon/sun data). Without it the homepage shows only an error.
NUXT_PUBLIC_MOON_API_KEY=your_rapidapi_moon_phase_key

# geocode.maps.co — turns a searched city into coordinates for the location selector.
NUXT_PUBLIC_GEOCODE_API_KEY=your_geocode_maps_co_key
