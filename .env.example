# LUNATRACK environment. Copy to .env and fill in.
# All keys are PRIVATE: only the Nitro server routes (/api/*) read them; the browser never sees them.

# RapidAPI — moon-phase.p.rapidapi.com (moon and sun data). Without it the homepage shows an error.
NUXT_MOON_API_KEY=your_rapidapi_moon_phase_key

# geocode.maps.co — city name <-> coordinates for the location selector.
NUXT_GEOCODE_API_KEY=your_geocode_maps_co_key

# Blog source: "hygraph" (default, public endpoint, no key) or "vams" (needs the two values below).
# NUXT_POSTS_SOURCE=hygraph
# NUXT_VAMS_URL=https://app.use-vams.me
# NUXT_VAMS_API_KEY=your_vams_api_key
# NUXT_VAMS_POST_TYPE=moon-post

# Legacy names NUXT_PUBLIC_MOON_API_KEY / NUXT_PUBLIC_GEOCODE_API_KEY are still read as a fallback.
